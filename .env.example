# RescueNet — environment variables
# Copy to .env and fill in your values.
# NEVER commit the filled-in .env file.

# ── Beacon ────────────────────────────────────────────────────────────────────
BEACON_ID=beacon-android-01
HQ_URL=https://your-hq.onrender.com    # or http://localhost:8000 for local dev
UPLOAD_INTERVAL=15
FLASK_PORT=8080
# Optional: hardcode beacon GPS if Termux:API is unavailable
# BEACON_LAT=34.021
# BEACON_LON=-118.287

# ── HQ ────────────────────────────────────────────────────────────────────────
HQ_PORT=8000
HQ_DB=hq.db

# Optional AI triage (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Optional Retell voice calls
RETELL_API_KEY=key_...
RETELL_AGENT_ID=agent_...
RETELL_FROM_NUMBER=+15550000001
RETELL_NOTIFY_NUMBER=+15550000002   # dispatcher phone for demo

# Set DEMO_MODE=true to simulate Retell calls without placing them
DEMO_MODE=true

# Optional dispatcher auth token (leave blank to disable auth)
DISPATCHER_TOKEN=
